# Groq API (LLM para chat - gratis)
GROQ_API_KEY=your_groq_api_key

# MiniMax API (embeddings)
MINIMAX_API_KEY=your_minimax_key
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# Pinecone (Vector DB)
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX=gc-housing
PINECONE_ENV=us-east-1

# INE Data (opcional, para descarga automática)
INE_CODIGO_MUNICIPIO=35020

# CORS - orígenes allowed separados por coma (default: http://localhost:8080)
ALLOWED_ORIGINS=http://localhost:8080
